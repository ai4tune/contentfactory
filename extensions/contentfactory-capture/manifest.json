{
  "manifest_version": 3,
  "name": "内容工厂账号采集助手",
  "version": "0.2.0",
  "description": "Capture visible account profile data, preview AI positioning, and confirm it in Content Factory.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://localhost/*", "http://127.0.0.1/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "action": {
    "default_title": "采集账号到内容工厂",
    "default_popup": "popup.html"
  }
}
