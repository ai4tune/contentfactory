{
  "name": "contentfactory",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "test:api": "npm run build && node --test src/tests/core-api.test.mjs src/tests/persistence-restart.test.mjs",
    "test:extension": "node --test src/tests/extension-*.test.mjs",
    "test:guardrails": "node --test src/tests/production-guardrails.test.mjs src/tests/data-maintenance.test.mjs src/tests/json-file-store.test.mjs",
    "test:v2": "npm run build && node --test src/tests/v2-handoff.test.mjs",
    "test:acceptance": "npm run lint && npm run test:guardrails && npm run test:extension && npm run test:api && node --test src/tests/v2-handoff.test.mjs",
    "data:backup": "node ops/data-maintenance.mjs backup",
    "data:restore": "node ops/data-maintenance.mjs restore",
    "data:delete": "node ops/data-maintenance.mjs delete"
  },
  "dependencies": {
    "better-sqlite3": "^11.0.0",
    "next": "16.3.5",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
