FEISHU_APP_ID=
FEISHU_APP_SECRET=

# Vercel + Supabase：App Router 登录与云端持久化
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# 仅服务端使用，绝不能增加 NEXT_PUBLIC_ 前缀
SUPABASE_SECRET_KEY=
# 执行 supabase/migrations 后创建的客户空间 UUID
CONTENT_FACTORY_WORKSPACE_ID=
# 正式域名，例如 https://content.example.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Docker 兼容模式：未配置 Supabase 时使用独立实例和访问码
CONTENT_FACTORY_ACCESS_USER=contentfactory
CONTENT_FACTORY_ACCESS_CODE=
# 生产环境挂载到持久化卷，例如 /app/data
CONTENT_FACTORY_DATA_DIR=
# 数据维护脚本的默认备份目录，例如 /app/backups
CONTENT_FACTORY_BACKUP_DIR=

AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_REQUEST_TIMEOUT_MS=60000
# 可选：每百万输入/输出 token 的成本，用于内部估算
AI_INPUT_COST_PER_1M=
AI_OUTPUT_COST_PER_1M=

IMAGE_BASE_URL=https://img.xingren.me/v1
IMAGE_API_KEY=
IMAGE_MODEL=gpt-image-2
IMAGE_SIZE=1024x1536
IMAGE_REQUEST_TIMEOUT_MS=180000
# 可选：单次生图成本，用于内部估算
IMAGE_COST_PER_REQUEST=

UPLOADS_ENABLED=true

# Chrome 账号采集接口：远程部署必须配置令牌；Origin 只控制 CORS
CAPTURE_ALLOWED_ORIGINS=
CONTENT_FACTORY_CAPTURE_TOKEN=

# RedFox API 配置（市场雷达功能）
REDFOX_API_KEY=
REDFOX_HOST=redfox.hk
# 可选：完整 API 主机地址（不要包含 /story/api），优先于 REDFOX_HOST
REDFOX_BASE_URL=https://redfox.hk
MARKET_REQUEST_TIMEOUT_MS=12000
# 可选：单次市场数据请求成本，用于内部估算
MARKET_COST_PER_REQUEST=
